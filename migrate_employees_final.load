LOAD DATABASE
     FROM sqlite:///Users/Work/Desktop/ERP/hr_platform.db
     INTO postgresql://erp_admin:MeatbalL20082012@localhost/localgov_erp

WITH include drop, create tables, create indexes, reset sequences,
     downcase identifiers,
     batch rows = 10000,
     batch concurrency = 1,
     on error resume next

INCLUDING ONLY TABLE NAMES LIKE 'employees'

CAST column employees.carried_forward_leave to integer drop typemod using "0",
     column employees.days_availed to integer drop typemod using "0",
     column employees.leave_taken to integer drop typemod using "0",
     column employees.leave_commuted to integer drop typemod using "0",
     column employees.leave_transferred_out to integer drop typemod using "0",
     column employees.leave_balance to integer drop typemod using "0",
     column employees.supervisor_id to text drop typemod using string;
