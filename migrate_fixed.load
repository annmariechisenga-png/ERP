LOAD DATABASE
     FROM sqlite:///Users/Work/Desktop/ERP/hr_platform.db
     INTO postgresql://erp_admin:MeatbalL20082012@localhost/localgov_erp

WITH include drop, create tables, create indexes, reset sequences,
     downcase identifiers,
     batch rows = 10000,
     batch concurrency = 1

SET PostgreSQL PARAMETERS
     maintenance_work_mem to '128MB',
     work_mem to '12MB'

CAST type datetime to timestamptz drop default drop not null using zero-dates-to-null,
     type timestamp to timestamptz drop default drop not null using zero-dates-to-null,
     type int when unsigned to int drop typemod,
     type int to int drop typemod;

-- Special handling for mothers_day_leave_tracking
ALTER TABLE NAMES MATCHING 'mothers_day_leave_tracking'
  ALTER COLUMN employee_id TYPE text;
